# Server-only values. Copy to ignored .env; never commit credentials.
OPENAI_API_KEY=
OPENAI_MODEL=

# Cloudflare resource identity for deployment. Not secrets. Leave unset for local
# previews, which fall back to a placeholder database and Miniflare's local state.
# Values come from `npx wrangler d1 create` and `npx wrangler r2 bucket create`.
D1_DATABASE_ID=
D1_DATABASE_NAME=site-creator-d1
R2_BUCKET_NAME=site-creator-r2
