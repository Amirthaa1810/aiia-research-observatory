# Normalise line endings to LF in the repository and on checkout.
* text=auto eol=lf

# Keep binary assets byte-identical.
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated drizzle snapshots keep their exact upstream shape.
drizzle/meta/*.json -diff
